<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <LocalDebuggerWorkingDirectory>$(SolutionDir)\bin\$(Platform)vc14</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <LocalDebuggerCommand>$(SolutionDir)\bin\$(Platform)vc14\MtAssistant.exe</LocalDebuggerCommand>
  </PropertyGroup>
  <PropertyGroup>
    <RESOURCE_FILE>MtAssistant.rc</RESOURCE_FILE>
  </PropertyGroup>
</Project>