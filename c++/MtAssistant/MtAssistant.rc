IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About MtAssistant"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "MtAssistant, Version 1.0",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2024",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "OK",IDOK,113,41,50,14,WS_GROUP
END

IDD_SERVICE_DIALOG DIALOGEX 0, 0, 549, 261
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "MtAssistant"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Program",IDC_STATIC,389,5,155,251
    LTEXT           "Choose:",IDC_CHOOSE_STATIC,397,19,36,11
    PUSHBUTTON      "Add",IDC_ADD_BUTTON,433,36,36,14
    PUSHBUTTON      "Delete",IDC_DEL_BUTTON,469,36,36,14
    LTEXT           "Args:",IDC_PARAM_STATIC,396,61,37,11
    GROUPBOX        "Schedule",IDC_STATIC,393,76,147,173
    LTEXT           "Week:",IDC_WEEK_STATIC,412,89,26,11
    LTEXT           "Start:",IDC_START_STATIC,398,109,34,11
    LTEXT           "End:",IDC_END_STATIC,398,128,34,11
    CONTROL         "",IDC_START_DATETIMEPICKER,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,443,105,89,15
    CONTROL         "",IDC_END_DATETIMEPICKER,"SysDateTimePick32",DTS_RIGHTALIGN | DTS_UPDOWN | WS_TABSTOP | 0x8,443,124,89,15
    PUSHBUTTON      "Delete",IDC_TIME_DEL_BUTTON,486,146,36,14
    PUSHBUTTON      "Add",IDC_TIME_ADD_BUTTON,413,146,36,14
    EDITTEXT        IDC_PARAM_EDIT,443,58,96,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EXE_EDIT,436,17,103,14,ES_AUTOHSCROLL | ES_READONLY
    CONTROL         "",IDC_SERVICE_LIST,"SysListView32",LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,5,5,380,251
    CONTROL         "",IDC_TIME_LIST,"SysListView32",LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,399,166,136,77
    PUSHBUTTON      "Browse",IDC_LOOK_BUTTON,397,36,36,14
    COMBOBOX        IDC_WEEK_COMBO,443,87,89,86,CBS_DROPDOWN | WS_VSCROLL,WS_EX_STATICEDGE
    PUSHBUTTON      "Log",IDC_LOG_BUTTON,505,36,36,14
END

IDD_LOG_DIALOG DIALOGEX 0, 0, 328, 209
STYLE DS_SETFONT | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CAPTION | WS_SYSMENU
CAPTION "MtAssistant Log"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
