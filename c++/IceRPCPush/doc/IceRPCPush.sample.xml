<?xml version="1.0" encoding="utf-8"?>
<!--
	IceRPCPush XML 配置示例。
	旧版 cfg/properties 文件仍可继续使用；文件扩展名为 .xml 时使用本格式。
	本示例只演示底层通用网络库配置，业务插件数量由 CloudNetDataApi 的 CloudNet 节决定。
-->
<IceRPCPush>
	<!-- Ice 节等价于旧 .properties 文件中的 key=value。 -->
	<Ice>
		<!-- 本进程在 Ice 日志和运行时中的程序名。 -->
		<Property name="Ice.ProgramName" value="IceRPCPush" />
		<!-- 服务端 servant 的 Ice Identity，旧代码读取 Identity 后 add 到 adapter；CloudNetDataApi 组网模式会按 Local.service 生成运行时 Identity。 -->
		<Property name="Identity" value="GatewayRPC" />
		<!-- 服务端 endpoint；CreateJsonICEServer 第二个参数传 GatewayRPC。 -->
		<Property name="GatewayRPC.Endpoints" value="tcp -z -h * -p 30001" />
		<!-- 客户端代理配置；CreateJsonICEClient 的 proxyProperty 传 GatewayRPC。使用 Locator 时可直接写服务名。 -->
		<Property name="GatewayRPC" value="GatewayRPC" />
		<!-- 双向回调使用 client adapter；RegisterJsonICEClient 需要。 -->
		<Property name="GatewayRPC.Client.Endpoints" value="default -z -h localhost" />
		<!-- IceGrid/Locator 地址；默认对齐新版 MtIceGrid 注册中心，不用 Locator 可删除或留空。 -->
		<Property name="Ice.Default.Locator" value="MtIceGrid/Locator:default -h 127.0.0.1 -p 18000" />
	</Ice>

	<!-- ICEPUSH 节等价于旧 INI 的 [ICEPUSH]。 -->
	<ICEPUSH>
		<!-- 异步 RPC 是否等待完成：1 保持旧版阻塞行为，0 立即返回以提升吞吐。 -->
		<AsyncWaitCompleted>1</AsyncWaitCompleted>

		<!-- LogLevel：日志级别，可选 debug/info/warn/error/off。 -->
		<LogLevel>info</LogLevel>
		<!-- DebugLog：兼容旧版调试日志开关；LogLevel 缺失时生效。 -->
		<DebugLog>0</DebugLog>

		<!-- 服务端 TCP 推送绑定端口；0 表示不开启。 -->
		<RPCPushBindport>0</RPCPushBindport>
		<!-- 服务端 TCP 推送绑定 IP。 -->
		<RPCPushBindip>127.0.0.1</RPCPushBindip>
		<!-- 服务端 UDP 点对点推送绑定端口；0 表示不开启。 -->
		<RPCXPushBindport>0</RPCXPushBindport>
		<!-- 服务端 UDP 点对点推送绑定 IP。 -->
		<RPCXPushBindip>127.0.0.1</RPCXPushBindip>
		<!-- UDP 接收线程数，非法值回退 3。 -->
		<RPCXThreadNum>3</RPCXThreadNum>
		<!-- 服务端允许的 TCP 推送最大连接数，非法值回退 1000。 -->
		<RPCPushmax>1000</RPCPushmax>

		<!-- 客户端 TCP 推送目标端口；0 表示不开启。 -->
		<RPCPushport>0</RPCPushport>
		<!-- 客户端 TCP 推送目标 IP。 -->
		<RPCPuship></RPCPuship>
		<!-- 客户端 UDP 点对点推送目标端口；0 表示不开启。 -->
		<RPCXPushport>0</RPCXPushport>
		<!-- 客户端 UDP 点对点推送目标 IP。 -->
		<RPCXPuship></RPCXPuship>
		<!-- 服务端/客户端组播推送端口；0 表示不开启。 -->
		<RPCMPushport>0</RPCMPushport>
		<!-- 服务端/客户端组播推送 IP。 -->
		<RPCMPuship>127.0.0.1</RPCMPuship>
	</ICEPUSH>
</IceRPCPush>
