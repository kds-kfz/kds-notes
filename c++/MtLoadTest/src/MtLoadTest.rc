IDR_MAIN_MENU MENU
BEGIN
    POPUP "压力测试(&L)"
    BEGIN
        MENUITEM "打开压力测试",                      ID_MENU_LOAD_TEST
    END
    POPUP "接口测试(&I)"
    BEGIN
        MENUITEM "打开接口测试",                      ID_MENU_INTERFACE_TEST
    END
    POPUP "数据查看(&D)"
    BEGIN
        MENUITEM "打开数据查看",                      ID_MENU_DATA_VIEWER
    END
END


