IDD_INTERFACE_TEST_DIALOG DIALOGEX 0, 0, 680, 500
STYLE DS_SETFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "通用接口测试 - HTTP / HTTPS / Web JSON"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "配置文件:",IDC_STATIC,6,7,34,10
    EDITTEXT        IDC_INTERFACE_CONFIG_PATH,42,5,470,13,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "浏览",IDC_INTERFACE_BROWSE,516,4,38,15
    PUSHBUTTON      "加载",IDC_INTERFACE_LOAD,556,4,38,15
    PUSHBUTTON      "保存",IDC_INTERFACE_SAVE,596,4,38,15
    PUSHBUTTON      "关闭",IDCANCEL,636,4,38,15

    LTEXT           "环境:",IDC_STATIC,6,24,34,10
    COMBOBOX        IDC_INTERFACE_ENV,42,22,118,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "服务类型:",IDC_STATIC,166,24,42,10
    COMBOBOX        IDC_INTERFACE_TRANSPORT,210,22,86,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "服务器:",IDC_STATIC,302,24,34,10
    COMBOBOX        IDC_INTERFACE_SERVER,338,22,174,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "连接",IDC_INTERFACE_CONNECT,516,21,38,15
    PUSHBUTTON      "断开",IDC_INTERFACE_DISCONNECT,556,21,38,15
    PUSHBUTTON      "发送",IDC_INTERFACE_SEND,596,21,38,15
    PUSHBUTTON      "取消",IDC_INTERFACE_CANCEL,636,21,38,15

    LTEXT           "报文协议:",IDC_STATIC,6,41,34,10
    COMBOBOX        IDC_INTERFACE_PROTOCOL,42,39,118,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "变量组:",IDC_STATIC,166,41,42,10
    COMBOBOX        IDC_INTERFACE_VARIABLE_SET,210,39,86,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "接口分类:",IDC_STATIC,302,41,34,10
    COMBOBOX        IDC_INTERFACE_CATEGORY,338,39,174,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "日志",IDC_INTERFACE_LOG,516,38,38,15
    PUSHBUTTON      "清空消息",IDC_INTERFACE_WEB_CLEAR,556,38,38,15

    LTEXT           "接口名称:",IDC_STATIC,6,58,34,10
    COMBOBOX        IDC_INTERFACE_CASE,42,56,254,160,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "方法:",IDC_STATIC,302,58,24,10
    EDITTEXT        IDC_INTERFACE_METHOD,328,56,50,13,ES_AUTOHSCROLL
    LTEXT           "路径:",IDC_STATIC,382,58,24,10
    EDITTEXT        IDC_INTERFACE_PATH,408,56,266,13,ES_AUTOHSCROLL

    GROUPBOX        "接口说明",IDC_STATIC,6,72,668,43
    EDITTEXT        IDC_INTERFACE_DESCRIPTION,12,82,656,27,ES_MULTILINE | ES_AUTOVSCROLL | ES_READONLY | WS_VSCROLL

    GROUPBOX        "字段表",IDC_STATIC,6,117,402,118
    CONTROL         "",IDC_INTERFACE_FIELD_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,12,128,390,85
    LTEXT           "Pointer:",IDC_STATIC,12,218,34,10
    EDITTEXT        IDC_INTERFACE_FIELD_PATH,47,216,112,13,ES_AUTOHSCROLL
    LTEXT           "类型:",IDC_STATIC,164,218,22,10
    COMBOBOX        IDC_INTERFACE_FIELD_TYPE,188,216,58,80,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "值:",IDC_STATIC,250,218,14,10
    EDITTEXT        IDC_INTERFACE_FIELD_VALUE,266,216,74,13,ES_AUTOHSCROLL
    PUSHBUTTON      "应用",IDC_INTERFACE_FIELD_APPLY,343,215,28,15
    PUSHBUTTON      "新增",IDC_INTERFACE_FIELD_ADD,373,215,28,15

    GROUPBOX        "原始 JSON",IDC_STATIC,412,117,262,118
    EDITTEXT        IDC_INTERFACE_REQUEST,418,128,250,85,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_HSCROLL | WS_VSCROLL
    PUSHBUTTON      "同步到字段表",IDC_INTERFACE_JSON_APPLY,590,215,78,15
    PUSHBUTTON      "删除字段",IDC_INTERFACE_FIELD_DELETE,510,215,76,15

    GROUPBOX        "请求头（配置表达式）",IDC_STATIC,6,237,214,68
    EDITTEXT        IDC_INTERFACE_HEADERS,12,249,202,50,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | WS_HSCROLL | WS_VSCROLL
    GROUPBOX        "实际请求（敏感值脱敏）",IDC_STATIC,224,237,450,68
    EDITTEXT        IDC_INTERFACE_ACTUAL_REQUEST,230,249,438,50,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_HSCROLL | WS_VSCROLL

    GROUPBOX        "应答",IDC_STATIC,6,307,668,94
    EDITTEXT        IDC_INTERFACE_RESPONSE_STATUS,12,318,656,13,ES_AUTOHSCROLL | ES_READONLY
    EDITTEXT        IDC_INTERFACE_RESPONSE_HEADERS,12,334,202,59,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_HSCROLL | WS_VSCROLL
    EDITTEXT        IDC_INTERFACE_RESPONSE,218,334,450,59,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_HSCROLL | WS_VSCROLL

    GROUPBOX        "WebSocket 消息（最多保留配置上限，默认 5000 条）",IDC_STATIC,6,403,668,81
    CONTROL         "",IDC_INTERFACE_WEB_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,12,414,440,64
    EDITTEXT        IDC_INTERFACE_WEB_DETAIL,456,414,212,64,ES_MULTILINE | ES_AUTOVSCROLL | ES_AUTOHSCROLL | ES_READONLY | WS_HSCROLL | WS_VSCROLL
    LTEXT           "准备就绪",IDC_INTERFACE_STATUS,8,487,666,10,SS_LEFTNOWORDWRAP
END

