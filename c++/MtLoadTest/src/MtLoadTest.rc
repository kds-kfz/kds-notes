IDD_MAIN_DIALOG DIALOGEX 0, 0, 210, 140
STYLE DS_SETFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Mt 测试与数据工具"
MENU IDR_MAIN_MENU
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "选择要使用的工具",IDC_STATIC,7,7,68,11
    PUSHBUTTON      "压力测试",IDC_OPEN_LOAD_TEST,7,22,33,18
    PUSHBUTTON      "接口测试",IDC_OPEN_INTERFACE_TEST,47,22,33,18
    PUSHBUTTON      "数据查看",IDC_OPEN_DATA_VIEWER,86,22,33,18
    GROUPBOX        "功能边界",IDC_STATIC,6,53,194,55
    LTEXT           "压力测试：读取 MtLoadEngine XML 计划并执行场景压测。",IDC_STATIC,17,67,175,14
    LTEXT           "接口测试：使用独立配置编辑并发送单次 HTTP/TCP 请求。",IDC_STATIC,17,79,175,14
    LTEXT           "数据查看：解析、编辑并另存 V3 本地二进制数据文件。",IDC_STATIC,17,91,175,14
    CONTROL         "准备就绪",IDC_MAIN_STATUS,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,9,126,175,8
END

IDD_MTLOADTEST_DIALOG DIALOGEX 0, 0, 620, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "MtLoadTest"
FONT 9, "Microsoft YaHei UI", 400, 0, 0x1
BEGIN
    LTEXT           "计划文件:",IDC_STATIC,6,6,48,12
    EDITTEXT        IDC_PLAN_PATH,39,4,225,12,ES_AUTOHSCROLL | ES_READONLY
    PUSHBUTTON      "浏览",IDC_BROWSE_PLAN,481,17,30,15
    PUSHBUTTON      "加载",IDC_VALIDATE_PLAN,510,17,30,15
    PUSHBUTTON      "日志",IDC_LOG_BUTTON,539,17,30,15
    PUSHBUTTON      "导出",IDC_EXPORT_RESULTS,568,17,30,15
    LTEXT           "运行环境:",IDC_STATIC,6,20,48,12
    COMBOBOX        IDC_ENVIRONMENT,39,19,225,96,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "开始",IDC_START_RUN,481,32,30,15
    PUSHBUTTON      "暂停",IDC_PAUSE_RUN,510,32,30,15
    PUSHBUTTON      "清空",IDC_CLEAR_RESULTS,539,32,30,15
    LTEXT           "工作负载:",IDC_STATIC,6,33,48,12
    COMBOBOX        IDC_SCENARIO,39,32,225,104,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "压测用户:",IDC_STATIC,6,45,48,12
    COMBOBOX        IDC_USER,39,44,225,104,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "状态: CREATED",IDC_RUN_STATE,6,57,465,12
    CONTROL         "",IDC_TRANSACTION_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,6,69,610,62
    CONTROL         "",IDC_METRIC_LIST,"SysListView32",LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,6,134,610,130
    CONTROL         "准备就绪",IDC_STATUS_TEXT,"Static",SS_LEFTNOWORDWRAP | WS_GROUP,7,268,465,12
    GROUPBOX        "功能键",IDC_STATIC,473,7,133,47
END

