<?xml version="1.0" encoding="utf-8"?>
<!--
  mthub 指标绘图 V2 专用压测计划。

  使用约束：
  1. 本计划只使用 MT5、No=1、Login=4087，不包含 legacy 接口或其他账号。
  2. 每次运行前取得新的 mthub Access JWT，把 JWT 正文填入 MthubAccessToken；不要填写 "Bearer " 前缀。
  3. JWT 当前有效期约 15 分钟，10 分钟混合压测必须在签发后立即启动；本计划不提供 60 分钟耐久测试。
  4. 生命周期场景使用 runId/threadIndex/iterationIndex 生成隔离数据，并用 alwaysRun 删除收尾。
  5. 禁止把填入真实 JWT 的配置提交到仓库；压测结束后立即清空 MthubAccessToken。
-->
<MtLoadPlan version="1" name="指标绘图 V2 - MT5_1/4087">
  <Reports directory="" />

  <Environments default="dev">
    <Environment id="dev" name="开发环境" scheme="http" host="10.0.1.11" port="8086" basePath="" />
    <Environment id="test" name="测试环境" scheme="https" host="test.mhtradingterminal.com"
                 basePath="/api" tlsVerify="true"
                 tlsCaFile="F:\开发资料\MyCode\kds-notes\c++\MtLoadTest\conf\ssl\starfield-services-root-g2.pem" />
  </Environments>

  <Users>
    <User id="mt5-1-4087" name="MT5_1 / No=1 / Login=4087" version="5" no="1" login="4087">
      <!-- 只填写 JWT 正文，Authorization 请求头会自动添加 Bearer 前缀。 -->
      <Param name="MthubAccessToken" value="" />
      <Param name="ChartSymbolId" value="EURUSD" />
      <Param name="ChartInterval" value="1" />
    </User>
  </Users>

  <Targets>
    <Target id="v2-chart" transport="http" connectTimeoutMs="3000"
            requestTimeoutMs="5000" maxConnections="200" />
  </Targets>

  <Headers>
    <Header name="Content-Type" value="application/json" />
    <Header name="Accept" value="application/json" />
    <Header name="Accept-Encoding" value="gzip" />
    <Header name="Authorization" value="Bearer ${MthubAccessToken}" />
  </Headers>

  <Scenarios>
    <Scenario id="v2-chart-drawing-query" name="V2 绘图查询">
      <UserRefs><UserRef id="mt5-1-4087" /></UserRefs>
      <Load mode="closed" threads="10" rampUpMs="0" iterations="100" />
      <Step id="drawing-query" name="查询绘图" onError="continue">
        <Request id="drawing-query" label="POST /v2/chart/drawings 查询" target="v2-chart" method="POST" path="/v2/chart/drawings" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":4,"SymbolId":"${ChartSymbolId}"}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
    </Scenario>

    <Scenario id="v2-chart-indicator-query" name="V2 指标查询">
      <UserRefs><UserRef id="mt5-1-4087" /></UserRefs>
      <Load mode="closed" threads="10" rampUpMs="0" iterations="100" />
      <Step id="indicator-query" name="查询指标" onError="continue">
        <Request id="indicator-query" label="POST /v2/chart/indicators 查询" target="v2-chart" method="POST" path="/v2/chart/indicators" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":4}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
    </Scenario>

    <Scenario id="v2-chart-config-query" name="V2 图表配置查询">
      <UserRefs><UserRef id="mt5-1-4087" /></UserRefs>
      <Load mode="closed" threads="10" rampUpMs="0" iterations="100" />
      <Step id="config-query" name="查询图表配置" onError="continue">
        <Request id="config-query" label="POST /v2/chart/config 查询" target="v2-chart" method="POST" path="/v2/chart/config" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":4,"ConfigName":[]}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
    </Scenario>

    <Scenario id="v2-chart-drawing-lifecycle" name="V2 绘图生命周期">
      <UserRefs><UserRef id="mt5-1-4087" /></UserRefs>
      <Load mode="closed" threads="10" rampUpMs="0" iterations="10" />
      <Step id="drawing-create" name="新建绘图" onError="stop_iteration">
        <Request id="drawing-create" label="POST /v2/chart/drawings 新建" target="v2-chart" method="POST" path="/v2/chart/drawings" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":1,"SymbolId":"${ChartSymbolId}","Interval":${ChartInterval},"DrawingId":"v2-load-drawing-${runId}-${threadIndex}-${iterationIndex}","ToolType":"trendLine","Content":{"phase":"created"}}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
      <Step id="drawing-save" name="修改保存绘图" onError="stop_iteration">
        <Request id="drawing-save" label="POST /v2/chart/drawings 保存" target="v2-chart" method="POST" path="/v2/chart/drawings" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":3,"SymbolId":"${ChartSymbolId}","Interval":${ChartInterval},"DrawingId":"v2-load-drawing-${runId}-${threadIndex}-${iterationIndex}","ToolType":"trendLine","Content":{"phase":"saved"}}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
      <Step id="drawing-query" name="查询绘图" onError="stop_iteration">
        <Request id="drawing-query" label="POST /v2/chart/drawings 查询" target="v2-chart" method="POST" path="/v2/chart/drawings" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":4,"SymbolId":"${ChartSymbolId}","Interval":${ChartInterval},"DrawingId":"v2-load-drawing-${runId}-${threadIndex}-${iterationIndex}"}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /><Json path="$.Data.Drawings[0].DrawingId" operator="eq" value="v2-load-drawing-${runId}-${threadIndex}-${iterationIndex}" /></Assertions>
        </Request>
      </Step>
      <Step id="drawing-delete" name="删除绘图" onError="continue" alwaysRun="true">
        <Request id="drawing-delete" label="POST /v2/chart/drawings 删除" target="v2-chart" method="POST" path="/v2/chart/drawings" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":2,"SymbolId":"${ChartSymbolId}","Interval":${ChartInterval},"DrawingId":"v2-load-drawing-${runId}-${threadIndex}-${iterationIndex}"}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
    </Scenario>

    <Scenario id="v2-chart-indicator-lifecycle" name="V2 指标生命周期">
      <UserRefs><UserRef id="mt5-1-4087" /></UserRefs>
      <Load mode="closed" threads="10" rampUpMs="0" iterations="10" />
      <Step id="indicator-create" name="新建指标" onError="stop_iteration">
        <Request id="indicator-create" label="POST /v2/chart/indicators 新建" target="v2-chart" method="POST" path="/v2/chart/indicators" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":1,"IndicatorId":"v2-load-indicator-${runId}-${threadIndex}-${iterationIndex}","IndicatorType":"MA","Visible":true,"Content":{"phase":"created","period":14}}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
      <Step id="indicator-save" name="修改保存指标" onError="stop_iteration">
        <Request id="indicator-save" label="POST /v2/chart/indicators 保存" target="v2-chart" method="POST" path="/v2/chart/indicators" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":3,"IndicatorId":"v2-load-indicator-${runId}-${threadIndex}-${iterationIndex}","IndicatorType":"MA","Visible":true,"Content":{"phase":"saved","period":20}}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
      <Step id="indicator-query" name="查询指标" onError="stop_iteration">
        <Request id="indicator-query" label="POST /v2/chart/indicators 查询" target="v2-chart" method="POST" path="/v2/chart/indicators" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":4,"IndicatorId":"v2-load-indicator-${runId}-${threadIndex}-${iterationIndex}"}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /><Json path="$.Data.Indicators[0].IndicatorId" operator="eq" value="v2-load-indicator-${runId}-${threadIndex}-${iterationIndex}" /></Assertions>
        </Request>
      </Step>
      <Step id="indicator-delete" name="删除指标" onError="continue" alwaysRun="true">
        <Request id="indicator-delete" label="POST /v2/chart/indicators 删除" target="v2-chart" method="POST" path="/v2/chart/indicators" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":2,"IndicatorId":"v2-load-indicator-${runId}-${threadIndex}-${iterationIndex}"}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
    </Scenario>

    <Scenario id="v2-chart-config-lifecycle" name="V2 图表配置生命周期">
      <UserRefs><UserRef id="mt5-1-4087" /></UserRefs>
      <Load mode="closed" threads="10" rampUpMs="0" iterations="10" />
      <Step id="config-create" name="新建图表配置" onError="stop_iteration">
        <Request id="config-create" label="POST /v2/chart/config 新建" target="v2-chart" method="POST" path="/v2/chart/config" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":1,"ConfigName":["v2-load-config-${runId}-${threadIndex}-${iterationIndex}"],"Content":{"v2-load-config-${runId}-${threadIndex}-${iterationIndex}":{"phase":"created"}}}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
      <Step id="config-save" name="修改保存图表配置" onError="stop_iteration">
        <Request id="config-save" label="POST /v2/chart/config 保存" target="v2-chart" method="POST" path="/v2/chart/config" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":3,"ConfigName":["v2-load-config-${runId}-${threadIndex}-${iterationIndex}"],"Content":{"v2-load-config-${runId}-${threadIndex}-${iterationIndex}":{"phase":"saved"}}}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
      <Step id="config-query" name="查询图表配置" onError="stop_iteration">
        <Request id="config-query" label="POST /v2/chart/config 查询" target="v2-chart" method="POST" path="/v2/chart/config" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":4,"ConfigName":["v2-load-config-${runId}-${threadIndex}-${iterationIndex}"]}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /><Json path="$.Data.ConfigName[0]" operator="eq" value="v2-load-config-${runId}-${threadIndex}-${iterationIndex}" /></Assertions>
        </Request>
      </Step>
      <Step id="config-delete" name="删除图表配置" onError="continue" alwaysRun="true">
        <Request id="config-delete" label="POST /v2/chart/config 删除" target="v2-chart" method="POST" path="/v2/chart/config" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":2,"ConfigName":["v2-load-config-${runId}-${threadIndex}-${iterationIndex}"]}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
    </Scenario>

    <Scenario id="v2-chart-drawing-sync" name="V2 绘图批量同步">
      <UserRefs><UserRef id="mt5-1-4087" /></UserRefs>
      <Load mode="closed" threads="10" rampUpMs="0" iterations="10" />
      <Step id="drawing-sync-save" name="批量保存绘图" onError="stop_iteration">
        <Request id="drawing-sync-save" label="POST /v2/chart/drawings/sync 保存" target="v2-chart" method="POST" path="/v2/chart/drawings/sync" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":1,"SymbolId":"${ChartSymbolId}","Interval":${ChartInterval},"Drawings":[{"Id":"v2-load-sync-a-${runId}-${threadIndex}-${iterationIndex}","ToolType":"trendLine","Content":{"slot":"a"}},{"Id":"v2-load-sync-b-${runId}-${threadIndex}-${iterationIndex}","ToolType":"text","Content":{"slot":"b"}}]}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
      <Step id="drawing-sync-delete" name="批量删除绘图" onError="continue" alwaysRun="true">
        <Request id="drawing-sync-delete" label="POST /v2/chart/drawings/sync 删除" target="v2-chart" method="POST" path="/v2/chart/drawings/sync" codec="json">
          <Body><![CDATA[{"Version":${Version},"No":${No},"Login":${Login},"OptType":2,"SymbolId":"${ChartSymbolId}","Interval":${ChartInterval},"DrawingIds":"v2-load-sync-a-${runId}-${threadIndex}-${iterationIndex},v2-load-sync-b-${runId}-${threadIndex}-${iterationIndex}"}]]></Body>
          <Assertions><HttpStatus min="200" max="299" /><Json path="$.Code" operator="eq" value="0" /></Assertions>
        </Request>
      </Step>
    </Scenario>
  </Scenarios>

  <Workloads default="v2-chart-smoke">
    <Workload id="v2-chart-smoke" name="V2 指标绘图冒烟" type="smoke">
      <Load mode="closed" users="1" iterations="7" />
      <ScenarioRef id="v2-chart-drawing-query" weight="1" />
      <ScenarioRef id="v2-chart-indicator-query" weight="1" />
      <ScenarioRef id="v2-chart-config-query" weight="1" />
      <ScenarioRef id="v2-chart-drawing-lifecycle" weight="1" />
      <ScenarioRef id="v2-chart-indicator-lifecycle" weight="1" />
      <ScenarioRef id="v2-chart-config-lifecycle" weight="1" />
      <ScenarioRef id="v2-chart-drawing-sync" weight="1" />
      <Thresholds>
        <Threshold id="smoke-errors" name="接口错误率为零" scope="run" metric="errorRate" operator="eq" value="0" />
        <Threshold id="smoke-dropped" name="丢弃事务为零" scope="run" metric="droppedIterations" operator="eq" value="0" />
      </Thresholds>
    </Workload>

    <Workload id="v2-drawing-query-baseline" name="V2 绘图查询单接口基准" type="average">
      <Load mode="closed" users="10" iterations="100" />
      <ScenarioRef id="v2-chart-drawing-query" weight="1" />
      <Thresholds><Threshold id="drawing-query-errors" name="接口错误率为零" scope="run" metric="errorRate" operator="eq" value="0" /></Thresholds>
    </Workload>
    <Workload id="v2-indicator-query-baseline" name="V2 指标查询单接口基准" type="average">
      <Load mode="closed" users="10" iterations="100" />
      <ScenarioRef id="v2-chart-indicator-query" weight="1" />
      <Thresholds><Threshold id="indicator-query-errors" name="接口错误率为零" scope="run" metric="errorRate" operator="eq" value="0" /></Thresholds>
    </Workload>
    <Workload id="v2-config-query-baseline" name="V2 配置查询单接口基准" type="average">
      <Load mode="closed" users="10" iterations="100" />
      <ScenarioRef id="v2-chart-config-query" weight="1" />
      <Thresholds><Threshold id="config-query-errors" name="接口错误率为零" scope="run" metric="errorRate" operator="eq" value="0" /></Thresholds>
    </Workload>

    <Workload id="v2-drawing-lifecycle-baseline" name="V2 绘图生命周期基准" type="average">
      <Load mode="closed" users="10" iterations="10" />
      <ScenarioRef id="v2-chart-drawing-lifecycle" weight="1" />
      <Thresholds><Threshold id="drawing-life-errors" name="接口错误率为零" scope="run" metric="errorRate" operator="eq" value="0" /></Thresholds>
    </Workload>
    <Workload id="v2-indicator-lifecycle-baseline" name="V2 指标生命周期基准" type="average">
      <Load mode="closed" users="10" iterations="10" />
      <ScenarioRef id="v2-chart-indicator-lifecycle" weight="1" />
      <Thresholds><Threshold id="indicator-life-errors" name="接口错误率为零" scope="run" metric="errorRate" operator="eq" value="0" /></Thresholds>
    </Workload>
    <Workload id="v2-config-lifecycle-baseline" name="V2 配置生命周期基准" type="average">
      <Load mode="closed" users="10" iterations="10" />
      <ScenarioRef id="v2-chart-config-lifecycle" weight="1" />
      <Thresholds><Threshold id="config-life-errors" name="接口错误率为零" scope="run" metric="errorRate" operator="eq" value="0" /></Thresholds>
    </Workload>
    <Workload id="v2-drawing-sync-baseline" name="V2 绘图批量同步基准" type="average">
      <Load mode="closed" users="10" iterations="10" />
      <ScenarioRef id="v2-chart-drawing-sync" weight="1" />
      <Thresholds><Threshold id="drawing-sync-errors" name="接口错误率为零" scope="run" metric="errorRate" operator="eq" value="0" /></Thresholds>
    </Workload>

    <Workload id="v2-chart-mixed-10m" name="V2 指标绘图读写混合 20tx/s 10分钟" type="average">
      <Load mode="arrival" ratePerSec="20" durationMs="600000" preAllocatedUsers="20" maxUsers="100" />
      <ScenarioRef id="v2-chart-drawing-query" weight="27" />
      <ScenarioRef id="v2-chart-indicator-query" weight="27" />
      <ScenarioRef id="v2-chart-config-query" weight="26" />
      <ScenarioRef id="v2-chart-drawing-lifecycle" weight="7" />
      <ScenarioRef id="v2-chart-indicator-lifecycle" weight="7" />
      <ScenarioRef id="v2-chart-config-lifecycle" weight="6" />
      <Thresholds>
        <Threshold id="mixed-errors" name="接口错误率为零" scope="run" metric="errorRate" operator="eq" value="0" />
        <Threshold id="mixed-dropped" name="丢弃事务为零" scope="run" metric="droppedIterations" operator="eq" value="0" />
      </Thresholds>
    </Workload>
  </Workloads>
</MtLoadPlan>
